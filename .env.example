# Node Environment
NODE_ENV=development
PORT=4000

# Database Configuration (Dockerized)
# Use 'db' as hostname when running inside docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=complianceos
DATABASE_URL=postgresql://postgres:postgres@db:5432/complianceos?schema=public

# Database Configuration (Local/Direct)
# DATABASE_URL=postgresql://postgres:1125@localhost:5432/complianceos

# JWT Secrets
JWT_SECRET=7621b095a9e8a27c801910ef104a5360e60a0f05c54ac0c2a6a05b370bef1c07afcbfd18cf3b19c63687e571906463f4
JWT_REFRESH_SECRET=dummy_refresh_secret_12345

# Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=dummy-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase_service_account.json
