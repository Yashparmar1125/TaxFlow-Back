# Node Environment
NODE_ENV=development
PORT=4000

# Database Configuration (Dockerized)
# Use 'db' as hostname when running inside docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=complianceos
DATABASE_URL=postgresql://postgres:postgres@db:5432/complianceos?schema=public

# Database Configuration (Local/Direct)
# DATABASE_URL=postgresql://postgres:1125@localhost:5432/complianceos

# JWT Secrets
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase_service_account.json

