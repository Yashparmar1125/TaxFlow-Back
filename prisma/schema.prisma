generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CA
  CLIENT
}

enum TaskType {
  ITR
  GST_RETURN
  AUDIT
  ADVANCE_TAX
  OTHER
}

enum TaskStatus {
  pending
  in_review
  approved
  overdue
}

enum DocStatus {
  pending_review
  approved
  rejected
}

enum InvitationStatus {
  pending
  accepted
  expired
}

enum NotificationType {
  TASK_CREATED
  DOC_UPLOADED
  DOC_APPROVED
  DOC_REJECTED
  MESSAGE_RECEIVED
  DEADLINE_REMINDER
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(255)
  password_hash String?  @db.VarChar(255)
  full_name     String   @db.VarChar(100)
  role          Role     @default(CLIENT)
  firmId        String?  @db.Uuid
  caId          String?  @db.Uuid
  phone         String?  @db.VarChar(20)
  membership_id String?  @unique @db.VarChar(50)
  experience_years Int?
  bio           String?  @db.Text
  specializations String[] @default([])
  avatar_url    String?  @db.VarChar(255)
  fcm_token     String?  @db.Text
  firebaseUid   String?  @unique @db.VarChar(128)
  googleId           String?  @unique @db.VarChar(255)
  googleEmail        String?  @db.VarChar(255)
  googleAccessToken  String?  @db.Text
  googleRefreshToken String?  @db.Text
  is_active     Boolean  @default(true)
  is_onboarded  Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  firm           Firm?          @relation(fields: [firmId], references: [id])
  refreshTokens  RefreshToken[]
  clientProfile  ClientProfile? @relation("UserToProfile")
  managedClients ClientProfile[] @relation("CAToProfile")
  tasksAsCA      ComplianceTask[] @relation("CAToTask")
  notifications  Notification[]
  messagesSent   Message[]
  threadsAsCA    MessageThread[] @relation("CAInThread")
  invitations    Invitation[]    @relation("CAInvites")

  @@map("users")
}

model Firm {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(100)
  address          String?  @db.Text
  registration_number String? @db.VarChar(50)
  phone            String?  @db.VarChar(20)
  email            String?  @db.VarChar(255)
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  members          User[]
  clients          ClientProfile[]

  @@map("firms")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique @db.VarChar(512)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("refresh_tokens")
}

model ClientProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  caId         String?  @db.Uuid
  firmId       String?  @db.Uuid
  name         String   @db.VarChar(100)
  pan          String?  @db.VarChar(10)
  phone        String?  @db.VarChar(20)
  address      String?  @db.Text
  
  // Adaptive Fields
  stakeholderType String? @db.VarChar(50)
  businessName    String? @db.VarChar(100)
  companyName     String? @db.VarChar(100)
  gstin           String? @db.VarChar(15)
  specialization  String? @db.VarChar(100)
  investmentFocus String? @db.VarChar(100)
  personalization Json?   @default("{}")

  riskLevel    String?  @db.VarChar(20)
  driveFolder  String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamptz

  user         User     @relation("UserToProfile", fields: [userId], references: [id])
  ca           User?    @relation("CAToProfile", fields: [caId], references: [id])
  firm         Firm?    @relation(fields: [firmId], references: [id])
  tasks        ComplianceTask[]
  documents    Document[]
  threads      MessageThread[]

  @@unique([caId, pan])
  @@map("client_profiles")
}

model ComplianceTask {
  id                String     @id @default(uuid()) @db.Uuid
  caId              String     @db.Uuid
  clientId          String     @db.Uuid
  ruleId            String?    @db.Uuid
  fy                String     @db.VarChar(7)
  title             String     @db.VarChar(200)
  taskType          TaskType
  status            TaskStatus @default(pending)
  dueDate           DateTime   @db.Timestamptz
  description       String?    @db.Text
  documentChecklist String[]   @default([])
  createdAt         DateTime   @default(now()) @db.Timestamptz
  updatedAt         DateTime   @updatedAt @db.Timestamptz

  ca               User           @relation("CAToTask", fields: [caId], references: [id])
  client           ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rule             ComplianceRule? @relation(fields: [ruleId], references: [id])
  documents        Document[]
  messageThreads   MessageThread[]

  @@map("compliance_tasks")
}

model ComplianceRule {
  id                String    @id @default(uuid()) @db.Uuid
  caId              String    @db.Uuid
  title             String    @db.VarChar(200)
  taskType          TaskType
  dueDaysFromFYEnd  Int
  documentChecklist String[]  @default([])
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now()) @db.Timestamptz
  
  // New fields to support custom practice rules from frontend
  financialYear     String?   @db.VarChar(20)
  officialDueDate   DateTime? @db.Timestamptz
  internalDueDate   DateTime? @db.Timestamptz
  applicableTypes   String[]  @default([])
  reminderDays      Int[]     @default([30, 7, 1])
  defaultNotes      String?   @db.Text
  defaultPriority   String?   @db.VarChar(20)

  tasks             ComplianceTask[]

  @@map("compliance_rules")
}

model Document {
  id                String    @id @default(uuid()) @db.Uuid
  taskId            String    @db.Uuid
  clientId          String    @db.Uuid
  caId              String    @db.Uuid
  driveFileId       String    @unique @db.VarChar(255)
  fileName          String    @db.VarChar(255)
  documentType      String    @db.VarChar(100)
  mimeType          String    @db.VarChar(100)
  sizeBytes         Int
  status            DocStatus @default(pending_review)
  rejectionReason   String?   @db.Text
  version           Int       @default(1)
  previousVersionId String?   @db.Uuid
  uploadedAt        DateTime  @default(now()) @db.Timestamptz
  reviewedAt        DateTime? @db.Timestamptz
  reviewedBy        String?   @db.Uuid

  task              ComplianceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  client            ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@map("documents")
}

model MessageThread {
  id                 String   @id @default(uuid()) @db.Uuid
  caId               String   @db.Uuid
  clientId           String   @db.Uuid
  taskId             String?  @db.Uuid
  lastMessageAt      DateTime @default(now()) @db.Timestamptz
  lastMessagePreview String?  @db.VarChar(80)
  unreadCountCA      Int      @default(0)
  unreadCountClient  Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz

  ca                 User           @relation("CAInThread", fields: [caId], references: [id])
  client             ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  task               ComplianceTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  messages           Message[]

  @@unique([caId, clientId, taskId])
  @@map("message_threads")
}

model Message {
  id              String   @id @default(uuid()) @db.Uuid
  threadId        String   @db.Uuid
  senderId        String   @db.Uuid
  senderRole      Role
  content         String   @db.Text
  attachmentDocId String?  @db.Uuid
  readAt          DateTime? @db.Timestamptz
  createdAt       DateTime @default(now()) @db.Timestamptz

  thread          MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender          User          @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(100)
  body      String           @db.VarChar(200)
  refId     String?          @db.Uuid
  refType   String?          @db.VarChar(20)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamptz

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(10)
  email           String           @db.VarChar(255)
  phone           String?          @db.VarChar(20)
  name            String           @db.VarChar(100)
  stakeholderType String?          @db.VarChar(50)
  caId            String           @db.Uuid
  status          InvitationStatus @default(pending)
  expiresAt       DateTime         @db.Timestamptz
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  ca              User             @relation("CAInvites", fields: [caId], references: [id])

  @@map("invitations")
}
